# Copy to .env. docker compose reads it; so do the backend and scripts/dev.mjs.

# --- backend (Django) ---
DJANGO_SECRET_KEY=change-me
# 1 for local development (shows the browsable API, allows the dev secret key).
DJANGO_DEBUG=1
# A postgres:// URL, or "embedded" to run a private PostgreSQL from the pgserver
# wheel (pip install -r backend/requirements-dev.txt). docker compose sets its own.
DATABASE_URL=embedded
# Shared secret between scrapers and backend ("Authorization: Token <value>").
INGEST_TOKEN=dev-ingest-token
# Skip re-fetching an unchanged listing's detail page for this many hours.
DETAIL_MAX_AGE_HOURS=24
# A complete run won't close more than this share of a source's open jobs.
MAX_CLOSE_FRACTION=0.5

# --- scrapers ---
BOARDS_URL=http://127.0.0.1:4010
API_URL=http://127.0.0.1:8010
# Optional: path to Chrome/Chromium (found automatically if it is in a usual place).
# CHROME_PATH=
SCRAPE_CONCURRENCY=3
SCRAPE_DELAY_MS=100
# How often the compose scraper service runs (e.g. 15m, 1h).
SCRAPE_EVERY=30m

# --- mock boards ---
MOCK_SEED=13
# 0 turns off CityCareers' deliberate 503s.
MOCK_FAULTS=1
VALIDATE_SCHEMA=enabled
PROCESS_DATA=enabled
VALIDATE_SCHEMA=enabled
PROCESS_DATA=enabled